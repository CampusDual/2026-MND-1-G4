CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC."flyway_schema_history"("installed_rank" INTEGER NOT NULL,"version" VARCHAR(50),"description" VARCHAR(200) NOT NULL,"type" VARCHAR(20) NOT NULL,"script" VARCHAR(1000) NOT NULL,"checksum" INTEGER,"installed_by" VARCHAR(100) NOT NULL,"installed_on" TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,"execution_time" INTEGER NOT NULL,"success" BIT(1) NOT NULL,CONSTRAINT "flyway_schema_history_pk" PRIMARY KEY("installed_rank"))
CREATE INDEX "flyway_schema_history_s_idx" ON PUBLIC."flyway_schema_history"("success")
CREATE MEMORY TABLE PUBLIC.ROLES(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(80) NOT NULL,UNIQUE(NAME))
ALTER TABLE PUBLIC.ROLES ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USERS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USERNAME VARCHAR(80) NOT NULL,PASSWORD VARCHAR(120) NOT NULL,ENABLED BOOLEAN NOT NULL,UNIQUE(USERNAME))
ALTER TABLE PUBLIC.USERS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USER_ROLES(USER_ID BIGINT NOT NULL,ROLE_ID BIGINT NOT NULL,CONSTRAINT PK_USER_ROLES PRIMARY KEY(USER_ID,ROLE_ID),CONSTRAINT FK_USER_ROLES_USER FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USERS(ID),CONSTRAINT FK_USER_ROLES_ROLE FOREIGN KEY(ROLE_ID) REFERENCES PUBLIC.ROLES(ID))
CREATE MEMORY TABLE PUBLIC.DISTRIBUTOR(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(120) NOT NULL,ACTIVE BOOLEAN DEFAULT TRUE NOT NULL,UNIQUE(NAME))
ALTER TABLE PUBLIC.DISTRIBUTOR ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.STORE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DISTRIBUTOR_ID BIGINT NOT NULL,NAME VARCHAR(120) NOT NULL,ACTIVE BOOLEAN DEFAULT TRUE NOT NULL,CONSTRAINT UQ_STORE_DISTRIBUTOR_NAME UNIQUE(DISTRIBUTOR_ID,NAME),CONSTRAINT UQ_STORE_ID_DISTRIBUTOR UNIQUE(ID,DISTRIBUTOR_ID),CONSTRAINT FK_STORE_DISTRIBUTOR FOREIGN KEY(DISTRIBUTOR_ID) REFERENCES PUBLIC.DISTRIBUTOR(ID))
ALTER TABLE PUBLIC.STORE ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.WAITER(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DISTRIBUTOR_ID BIGINT NOT NULL,STORE_ID BIGINT NOT NULL,NAME VARCHAR(120) NOT NULL,ACTIVE BOOLEAN DEFAULT TRUE NOT NULL,CONSTRAINT UQ_WAITER_STORE_NAME UNIQUE(STORE_ID,NAME),CONSTRAINT FK_WAITER_STORE_DISTRIBUTOR FOREIGN KEY(STORE_ID,DISTRIBUTOR_ID) REFERENCES PUBLIC.STORE(ID,DISTRIBUTOR_ID))
ALTER TABLE PUBLIC.WAITER ALTER COLUMN ID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.MANAGER_PROFILE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DISTRIBUTOR_ID BIGINT NOT NULL,USER_ID BIGINT NOT NULL,UNIQUE(USER_ID),CONSTRAINT FK_MANAGER_PROFILE_DISTRIBUTOR FOREIGN KEY(DISTRIBUTOR_ID) REFERENCES PUBLIC.DISTRIBUTOR(ID),CONSTRAINT FK_MANAGER_PROFILE_USER FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USERS(ID))
ALTER TABLE PUBLIC.MANAGER_PROFILE ALTER COLUMN ID RESTART WITH 1
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
